{
    "manifest_version": 3,
    "name": "Firefly Companion",
    "description": "hover meaning",
    "permissions": [
        "scripting",
        "storage"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "スイッチ【オン・オフ】",
        "default_icon": {
            "32": "icons/32.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "ejdict.json",
                "template1.html",
                "template1.css"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "version": "1.0"
}